<UserControl x:Class="MetGlobalCompany.WPF.Views.PaymentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:controls="clr-namespace:MetGlobalCompany.WPF.Controls"
             xmlns:converters="clr-namespace:MetGlobalCompany.WPF.Converters"
             xmlns:behaviors="clr-namespace:MetGlobalCompany.WPF.Behaviors"
             Width="700" Background="{StaticResource MetGlobal.Brushes.BackgroundWhite}">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:EnumDescriptionConverter x:Key="EnumDescConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource MetGlobal.Brushes.BackgroundLight}" Padding="30,20" BorderThickness="0,0,0,1" BorderBrush="{StaticResource MetGlobal.Brushes.Border}">
            <Grid IsEnabled="{Binding CanEdit}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBox Text="{Binding Model.Number, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Номер ПП *" Margin="0,0,0,15"/>
                    <DatePicker SelectedDate="{Binding Model.Date}" mah:TextBoxHelper.Watermark="Дата ПП *"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <ComboBox ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding Model.Type}" mah:TextBoxHelper.Watermark="Тип платежа *">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Padding="30,20" IsEnabled="{Binding CanEdit}">
            <StackPanel>
                <controls:LookupControl Text="{Binding Model.Contractor.Name}" Watermark="Плательщик / Получатель *"
                                        SelectCommand="{Binding SelectContractorCommand}"
                                        ClearCommand="{Binding ClearContractorCommand}" Margin="0,0,0,20"/>
                <controls:LookupControl Text="{Binding Model.Contract.Number}" Watermark="Договор"
                                        SelectCommand="{Binding SelectContractCommand}"
                                        ClearCommand="{Binding ClearContractCommand}" Margin="0,0,0,20"/>
                <TextBox Text="{Binding Model.Amount, UpdateSourceTrigger=PropertyChanged}" behaviors:InputBehaviors.IsPositiveDecimalOnly="True" mah:TextBoxHelper.Watermark="Сумма *" Margin="0,0,0,20" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MetGlobal.Brushes.PrimaryRed}"/>
                <TextBox Text="{Binding Model.Purpose, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Назначение платежа" TextWrapping="Wrap" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource MetGlobal.Brushes.BackgroundLight}" Padding="20" BorderThickness="0,1,0,0" BorderBrush="{StaticResource MetGlobal.Brushes.Border}">
            <DockPanel>
                <TextBlock Text="Документ проведен. Изменения заблокированы." Foreground="{StaticResource MetGlobal.Brushes.PrimaryRed}" VerticalAlignment="Center" Visibility="{Binding Model.IsPosted, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="Закрыть" Style="{StaticResource MetGlobalFlatButtonStyle}" Margin="0,0,15,0" Width="100"/>
                    <Button Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="Сохранить" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Width="160" IsEnabled="{Binding CanEdit}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>