<mah:MetroWindow x:Class="MetGlobalCompany.WPF.Views.DialogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="{Binding Title}" 
                 TitleCharacterCasing="Normal"
                 TitleForeground="White"
                 WindowTitleBrush="{StaticResource MetGlobal.Brushes.SidebarBackground}"
                 WindowStartupLocation="CenterOwner"
                 GlowBrush="{StaticResource MetGlobal.Brushes.PrimaryRed}"
                 BorderThickness="1"
                 SizeToContent="WidthAndHeight"
                 MinHeight="300" MinWidth="400"
                 ShowMaxRestoreButton="False"
                 ShowMinButton="False"
                 Background="{StaticResource MetGlobal.Brushes.BackgroundLight}">

    <ContentControl Content="{Binding}" Margin="0" />

</mah:MetroWindow>