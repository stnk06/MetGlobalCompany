<UserControl x:Class="MetGlobalCompany.WPF.Views.PriceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource MetGlobal.Brushes.BackgroundWhite}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MetGlobal.Brushes.BackgroundLight}" BorderBrush="{StaticResource MetGlobal.Brushes.Border}" BorderThickness="0,0,0,1" Padding="15">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding AddNewCommand}" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Новая установка цен" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding EditCurrentCommand}" Style="{StaticResource MetGlobalOutlineButtonStyle}" Margin="0,0,30,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileDocumentEditOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Открыть" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding PostDocumentCommand}" ToolTip="Провести (зафиксировать цены)" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Background="{StaticResource MetGlobal.Brushes.SuccessGreen}" Margin="0,0,10,0" Padding="10,8">
                    <iconPacks:PackIconMaterial Kind="CheckAll" Foreground="White" Width="18" Height="18"/>
                </Button>
                <Button Command="{Binding UnpostDocumentCommand}" ToolTip="Отменить проведение" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Background="{StaticResource MetGlobal.Brushes.PrimaryRed}" Padding="10,8">
                    <iconPacks:PackIconMaterial Kind="Cancel" Foreground="White" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" Margin="15,15,15,15" ItemsSource="{Binding PriceSettings}" SelectedItem="{Binding SelectedPriceSetting}" Style="{StaticResource EnterpriseDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата начала действия" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" SortMemberPath="Date" Width="180"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number}" SortMemberPath="Number" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                <DataGridCheckBoxColumn Header="Проведен" Binding="{Binding IsPosted}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>