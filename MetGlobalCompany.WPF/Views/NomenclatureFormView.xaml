<UserControl x:Class="MetGlobalCompany.WPF.Views.NomenclatureFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             Width="650" Background="{StaticResource MetGlobal.Brushes.BackgroundWhite}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="30,20">
            <StackPanel>
                <TextBlock Text="Основные данные" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MetGlobal.Brushes.DarkText}" Margin="0,0,0,15"/>
                <TextBox Text="{Binding Model.Name, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Рабочее наименование *" Margin="0,0,0,20"/>
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Model.Article, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Артикул"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Units}" SelectedValue="{Binding Model.UnitId}" SelectedValuePath="Id" DisplayMemberPath="Name" 
                              mah:TextBoxHelper.Watermark="Единица измерения (ОКЕИ) *"/>
                </Grid>
                <TextBlock Text="Спецификация (характеристики)" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MetGlobal.Brushes.DarkText}" Margin="0,0,0,15"/>
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding GostPrefixes}" SelectedItem="{Binding SelectedGostPrefix}" Margin="0,0,5,0" mah:TextBoxHelper.Watermark="Тип"/>
                        <TextBox Grid.Column="1" Text="{Binding GostValue, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Значение ГОСТ / ТУ"/>
                    </Grid>
                    <TextBox Grid.Column="2" Text="{Binding Model.Density, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Марка стали / Плотность"/>
                </Grid>
                <CheckBox IsChecked="{Binding Model.IsService}" Content="Это услуга (не ведется складской учет)" Margin="0,0,0,10"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource MetGlobal.Brushes.BackgroundLight}" Padding="20" BorderThickness="0,1,0,0" BorderBrush="{StaticResource MetGlobal.Brushes.Border}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="Отмена" Style="{StaticResource MetGlobalFlatButtonStyle}" Margin="0,0,15,0" Width="100"/>
                <Button Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="Сохранить" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Width="150"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>