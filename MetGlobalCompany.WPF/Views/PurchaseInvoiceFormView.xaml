<UserControl x:Class="MetGlobalCompany.WPF.Views.PurchaseInvoiceFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:MetGlobalCompany.WPF.Converters"
             xmlns:controls="clr-namespace:MetGlobalCompany.WPF.Controls"
             Width="900" Height="650" Background="{StaticResource MetGlobal.Brushes.BackgroundWhite}">
    <UserControl.Resources>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MetGlobal.Brushes.BackgroundLight}" Padding="20" BorderThickness="0,0,0,1" BorderBrush="{StaticResource MetGlobal.Brushes.Border}">
            <Grid IsEnabled="{Binding CanEdit}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBox Text="{Binding Model.Number, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Номер документа *" Margin="0,0,0,15"/>
                    <DatePicker SelectedDate="{Binding Model.Date}" mah:TextBoxHelper.Watermark="Дата *"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <controls:LookupControl Text="{Binding Model.Contractor.Name}" Watermark="Поставщик *"
                                            SelectCommand="{Binding SelectContractorCommand}"
                                            ClearCommand="{Binding ClearContractorCommand}" Margin="0,0,0,15"/>
                    <controls:LookupControl Text="{Binding Model.Contract.Number}" Watermark="Договор *"
                                            SelectCommand="{Binding SelectContractCommand}"
                                            ClearCommand="{Binding ClearContractCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" IsEnabled="{Binding CanEdit}">
                <Button Command="{Binding AddDetailCommand}" Style="{StaticResource MetGlobalOutlineButtonStyle}" Margin="0,0,10,0" Foreground="{StaticResource MetGlobal.Brushes.PrimaryRed}" BorderBrush="{StaticResource MetGlobal.Brushes.PrimaryRed}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Добавить строку"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding EditDetailCommand}" CommandParameter="{Binding SelectedDetail}" Style="{StaticResource MetGlobalOutlineButtonStyle}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Pencil" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Редактировать"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding RemoveDetailCommand}" Style="{StaticResource MetGlobalOutlineButtonStyle}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Minus" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Удалить строку"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentDetails}" SelectedItem="{Binding SelectedDetail}" 
                      Style="{StaticResource EnterpriseDataGridStyle}" IsReadOnly="True">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditDetailCommand}" CommandParameter="{Binding SelectedDetail}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Номенклатура" Binding="{Binding Nomenclature.Name}" Width="*"/>
                    <DataGridTextColumn Header="Ед. изм" Binding="{Binding Nomenclature.Unit.Name}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource MetGlobal.Brushes.GrayText}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat={}{0:N3}}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Sum, StringFormat={}{0:N2}}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource MetGlobal.Brushes.BackgroundLight}" Padding="20" BorderThickness="0,1,0,0" BorderBrush="{StaticResource MetGlobal.Brushes.Border}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="ИТОГО:" FontSize="18" FontWeight="Bold" Margin="0,0,10,0" Foreground="{StaticResource MetGlobal.Brushes.DarkText}"/>
                    <TextBlock Text="{Binding Model.TotalAmount, StringFormat={}{0:N2} ₽}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MetGlobal.Brushes.PrimaryRed}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBlock Text="Документ проведен. Редактирование запрещено." Foreground="{StaticResource MetGlobal.Brushes.PrimaryRed}" VerticalAlignment="Center" Margin="0,0,20,0" Visibility="{Binding Model.IsPosted, Converter={StaticResource BoolToVis}}"/>
                    <Button Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="Закрыть" Style="{StaticResource MetGlobalFlatButtonStyle}" Margin="0,0,15,0" Width="100"/>
                    <Button Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="Сохранить" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Width="160" IsEnabled="{Binding CanEdit}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>