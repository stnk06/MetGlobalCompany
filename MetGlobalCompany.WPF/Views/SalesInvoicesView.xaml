<UserControl x:Class="MetGlobalCompany.WPF.Views.SalesInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:behaviors="clr-namespace:MetGlobalCompany.WPF.Behaviors"
             xmlns:controls="clr-namespace:MetGlobalCompany.WPF.Controls"
             Background="{StaticResource MetGlobal.Brushes.BackgroundWhite}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MetGlobal.Brushes.BackgroundLight}" BorderBrush="{StaticResource MetGlobal.Brushes.Border}" BorderThickness="0,0,0,1" Padding="15,10">
            <DockPanel>
                <controls:DateRangePicker StartDate="{Binding FilterStartDate, Mode=TwoWay}" EndDate="{Binding FilterEndDate, Mode=TwoWay}" DockPanel.Dock="Left"/>
                <Button Command="{Binding ClearFiltersCommand}" Content="Сбросить все фильтры" Style="{StaticResource MetGlobalFlatButtonStyle}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Padding="15">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding AddNewCommand}" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Создать УПД" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding EditCurrentCommand}" Style="{StaticResource MetGlobalOutlineButtonStyle}" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileDocumentEditOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Открыть" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding PreviewTorg12Command}" Style="{StaticResource MetGlobalOutlineButtonStyle}" Foreground="#1565C0" BorderBrush="#1565C0" ToolTip="Печатная форма ТОРГ-12" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Printer" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="ТОРГ-12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding PrintToExcelCommand}" Style="{StaticResource MetGlobalOutlineButtonStyle}" Foreground="{StaticResource MetGlobal.Brushes.SuccessGreen}" BorderBrush="{StaticResource MetGlobal.Brushes.SuccessGreen}" ToolTip="УПД в Excel" Margin="0,0,30,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileExcelBox" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="УПД" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding PostDocumentCommand}" ToolTip="Провести" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Background="{StaticResource MetGlobal.Brushes.SuccessGreen}" Margin="0,0,10,0" Padding="10,8">
                    <iconPacks:PackIconMaterial Kind="CheckAll" Foreground="White" Width="18" Height="18"/>
                </Button>
                <Button Command="{Binding UnpostDocumentCommand}" ToolTip="Отменить" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Background="{StaticResource MetGlobal.Brushes.PrimaryRed}" Margin="0,0,30,0" Padding="10,8">
                    <iconPacks:PackIconMaterial Kind="Cancel" Foreground="White" Width="18" Height="18"/>
                </Button>

                <TextBlock Text="Фильтры:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,15,0" Foreground="{StaticResource MetGlobal.Brushes.DarkText}"/>
                <ComboBox ItemsSource="{Binding AvailableContractors}" SelectedItem="{Binding SelectedContractorFilter}" Width="250" mah:TextBoxHelper.Watermark="Все контрагенты" mah:TextBoxHelper.ClearTextButton="True"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" Margin="15,0,15,15" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}" Style="{StaticResource EnterpriseDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" SortMemberPath="Date" Width="140"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number}" SortMemberPath="Number" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="behaviors:TextHighlightBehavior.HighlightText" Value="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Контрагент" Binding="{Binding Contractor.Name}" SortMemberPath="Contractor.Name" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="behaviors:TextHighlightBehavior.HighlightText" Value="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" SortMemberPath="TotalAmount" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Header="Проведен" Binding="{Binding IsPosted}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>