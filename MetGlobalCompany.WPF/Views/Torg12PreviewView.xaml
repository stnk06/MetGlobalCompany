<UserControl x:Class="MetGlobalCompany.WPF.Views.Torg12PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Width="1200" Height="800" Background="{StaticResource MetGlobal.Brushes.BackgroundLight}">

    <UserControl.Resources>
        <Style x:Key="Torg12DataGridStyle" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Black"/>
            <Setter Property="VerticalGridLinesBrush" Value="Black"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="20,15" BorderThickness="0,0,0,1" BorderBrush="{StaticResource MetGlobal.Brushes.Border}">
            <DockPanel>
                <TextBlock Text="Предпросмотр документа" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource MetGlobal.Brushes.DarkText}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Command="{Binding PrintCommand}" CommandParameter="{Binding ElementName=PrintPaper}" Style="{StaticResource MetGlobalOutlineButtonStyle}" BorderBrush="{StaticResource MetGlobal.Brushes.DarkText}" Foreground="{StaticResource MetGlobal.Brushes.DarkText}" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Printer" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Печать" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportToWordCommand}" Style="{StaticResource MetGlobalOutlineButtonStyle}" BorderBrush="#1565C0" Foreground="#1565C0" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileWord" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Скачать в Word" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Content="Закрыть"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#E5E5E5">
            <Border x:Name="PrintPaper" Width="1100" Background="White" Margin="30" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.1" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,0,20">
                        <TextBlock Text="Унифицированная форма № ТОРГ-12" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock Text="Утверждена постановлением Госкомстата России от 25.12.98 № 132" FontSize="11" HorizontalAlignment="Right"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Код" FontSize="11" HorizontalAlignment="Right" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="1,1,1,1" Padding="5,2">
                                <TextBlock Text="0310001" FontSize="11" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="по ОКПО" FontSize="11" HorizontalAlignment="Right" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,1" Padding="5,2"/>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Грузоотправитель" FontSize="12" Margin="0,5"/>
                        <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Invoice.Contractor.FullName}" FontSize="12" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Грузополучатель" FontSize="12" Margin="0,5"/>
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Invoice.Contractor.FullName}" FontSize="12" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Поставщик" FontSize="12" Margin="0,5"/>
                        <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1" Margin="10,0,0,0">
                            <TextBlock Text="ООО 'МЕТГЛОБАЛ'" FontSize="12" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Плательщик" FontSize="12" Margin="0,5"/>
                        <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Invoice.Contractor.FullName}" FontSize="12" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ТОВАРНАЯ НАКЛАДНАЯ" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,0"/>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Padding="15,5" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Номер документа" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Invoice.Number}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Padding="15,5">
                            <StackPanel>
                                <TextBlock Text="Дата составления" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Invoice.Date, StringFormat=dd.MM.yyyy}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding Invoice.Details}" Style="{StaticResource Torg12DataGridStyle}" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Товар (наименование, сорт, артикул)" Binding="{Binding Nomenclature.Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Код" Binding="{Binding Nomenclature.Article}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ед. изм." Binding="{Binding Nomenclature.Unit.Name}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat={}{0:F3}}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Цена, руб. коп." Binding="{Binding Price, StringFormat={}{0:F2}}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Сумма без НДС" Binding="{Binding Sum, StringFormat={}{0:F2}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="НДС" Binding="{Binding Source='Без НДС'}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Сумма с НДС" Binding="{Binding Sum, StringFormat={}{0:F2}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="4" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Всего по накладной:" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalQuantity, StringFormat={}{0:F3}}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" Padding="5,0"/>
                        <TextBlock Grid.Column="2" Text="X" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding TotalSum, StringFormat={}{0:F2}}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" Padding="5,0"/>
                        <TextBlock Grid.Column="4" Text="X" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="{Binding TotalSum, StringFormat={}{0:F2}}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" Padding="5,0"/>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Отпуск груза разрешил" FontSize="12" FontWeight="Bold"/>
                            <Border BorderBrush="Black" BorderThickness="0,0,0,1" Margin="0,20,0,0" Height="20"/>
                            <TextBlock Text="(должность, подпись, расшифровка)" FontSize="9" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Груз принял грузополучатель" FontSize="12" FontWeight="Bold"/>
                            <Border BorderBrush="Black" BorderThickness="0,0,0,1" Margin="0,20,0,0" Height="20"/>
                            <TextBlock Text="(должность, подпись, расшифровка)" FontSize="9" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>