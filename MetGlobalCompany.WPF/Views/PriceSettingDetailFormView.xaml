<UserControl x:Class="MetGlobalCompany.WPF.Views.PriceSettingDetailFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:controls="clr-namespace:MetGlobalCompany.WPF.Controls"
             xmlns:behaviors="clr-namespace:MetGlobalCompany.WPF.Behaviors"
             Width="500" Background="{StaticResource MetGlobal.Brushes.BackgroundWhite}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="30,25">
            <StackPanel>
                <controls:LookupControl Text="{Binding Nomenclature.Name}" Watermark="Выберите номенклатуру *"
                                        SelectCommand="{Binding SelectNomenclatureCommand}"
                                        ClearCommand="{Binding ClearNomenclatureCommand}" Margin="0,0,0,25"/>
                <ComboBox ItemsSource="{Binding PriceTypes}" SelectedItem="{Binding PriceType}" DisplayMemberPath="Name" 
                          mah:TextBoxHelper.Watermark="Тип цены *" Margin="0,0,0,25"/>
                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" behaviors:InputBehaviors.IsPositiveDecimalOnly="True" mah:TextBoxHelper.Watermark="Устанавливаемая цена *" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MetGlobal.Brushes.SuccessGreen}"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource MetGlobal.Brushes.BackgroundLight}" Padding="20" BorderThickness="0,1,0,0" BorderBrush="{StaticResource MetGlobal.Brushes.Border}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="Отмена" Style="{StaticResource MetGlobalFlatButtonStyle}" Margin="0,0,15,0" Width="100"/>
                <Button Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Content="Применить" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Width="150"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>