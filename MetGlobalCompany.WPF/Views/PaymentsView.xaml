<UserControl x:Class="MetGlobalCompany.WPF.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:MetGlobalCompany.WPF.Controls"
             xmlns:converters="clr-namespace:MetGlobalCompany.WPF.Converters"
             Background="{StaticResource MetGlobal.Brushes.BackgroundWhite}">
    <UserControl.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MetGlobal.Brushes.BackgroundLight}" BorderBrush="{StaticResource MetGlobal.Brushes.Border}" BorderThickness="0,0,0,1" Padding="15,10">
            <DockPanel>
                <controls:DateRangePicker StartDate="{Binding FilterStartDate, Mode=TwoWay}" EndDate="{Binding FilterEndDate, Mode=TwoWay}" DockPanel.Dock="Left"/>
                <Button Command="{Binding ClearFiltersCommand}" Content="Сбросить все фильтры" Style="{StaticResource MetGlobalFlatButtonStyle}" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Padding="15">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding AddNewCommand}" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Создать платеж" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding EditCurrentCommand}" Style="{StaticResource MetGlobalOutlineButtonStyle}" Margin="0,0,15,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FileDocumentEditOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Открыть" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ImportFrom1cCommand}" Style="{StaticResource MetGlobalOutlineButtonStyle}" Foreground="#1976D2" BorderBrush="#1976D2" ToolTip="Загрузить из txt файла выписки 1С" Margin="0,0,30,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="BankTransfer" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Импорт выписки 1С" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding PostDocumentCommand}" ToolTip="Провести" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Background="{StaticResource MetGlobal.Brushes.SuccessGreen}" Margin="0,0,10,0" Padding="10,8">
                    <iconPacks:PackIconMaterial Kind="CheckAll" Foreground="White" Width="18" Height="18"/>
                </Button>
                <Button Command="{Binding UnpostDocumentCommand}" ToolTip="Отменить" Style="{StaticResource MetGlobalPrimaryButtonStyle}" Background="{StaticResource MetGlobal.Brushes.PrimaryRed}" Margin="0,0,30,0" Padding="10,8">
                    <iconPacks:PackIconMaterial Kind="Cancel" Foreground="White" Width="18" Height="18"/>
                </Button>

                <TextBlock Text="Фильтры:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,15,0" Foreground="{StaticResource MetGlobal.Brushes.DarkText}"/>
                <ComboBox ItemsSource="{Binding AvailableContractors}" SelectedItem="{Binding SelectedContractorFilter}" Width="200" Margin="0,0,10,0" mah:TextBoxHelper.Watermark="Все контрагенты" mah:TextBoxHelper.ClearTextButton="True"/>
                <ComboBox ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding SelectedTypeFilter}" Width="150" mah:TextBoxHelper.Watermark="Любой тип" mah:TextBoxHelper.ClearTextButton="True">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" Margin="15,0,15,15" ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}" Style="{StaticResource EnterpriseDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" SortMemberPath="Date" Width="120"/>
                <DataGridTextColumn Header="Номер ПП" Binding="{Binding Number}" SortMemberPath="Number" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type, Converter={StaticResource EnumDescConverter}}" SortMemberPath="Type" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource MetGlobal.Brushes.GrayText}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Контрагент" Binding="{Binding Contractor.Name}" SortMemberPath="Contractor.Name" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} ₽}" SortMemberPath="Amount" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Header="Проведен" Binding="{Binding IsPosted}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>