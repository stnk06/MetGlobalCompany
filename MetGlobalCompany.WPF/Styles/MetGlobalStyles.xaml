<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <!-- ======================================================= -->
    <!-- 1. КОРПОРАТИВНАЯ ЦВЕТОВАЯ ПАЛИТРА (ENTERPRISE EDITION)  -->
    <!-- ======================================================= -->

    <SolidColorBrush x:Key="MetGlobal.Brushes.PrimaryRed" Color="#D32F2F" />
    <SolidColorBrush x:Key="MetGlobal.Brushes.PrimaryRedHover" Color="#B71C1C" />

    <SolidColorBrush x:Key="MetGlobal.Brushes.SidebarBackground" Color="#1E1E2D" />
    <SolidColorBrush x:Key="MetGlobal.Brushes.SidebarHover" Color="#2A2A3E" />
    <SolidColorBrush x:Key="MetGlobal.Brushes.SidebarSelected" Color="#33334C" />
    <SolidColorBrush x:Key="MetGlobal.Brushes.SidebarText" Color="#9A9CAB" />

    <SolidColorBrush x:Key="MetGlobal.Brushes.DarkText" Color="#202124" />
    <SolidColorBrush x:Key="MetGlobal.Brushes.GrayText" Color="#5F6368" />
    <SolidColorBrush x:Key="MetGlobal.Brushes.Border" Color="#E0E0E0" />
    <SolidColorBrush x:Key="MetGlobal.Brushes.BackgroundLight" Color="#F4F6F8" />
    <SolidColorBrush x:Key="MetGlobal.Brushes.BackgroundWhite" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MetGlobal.Brushes.SuccessGreen" Color="#2E7D32" />

    <SolidColorBrush x:Key="MetGlobal.Brushes.RowSelected" Color="#FCE4E4" />

    <!-- ИСПРАВЛЕНИЕ: Очень мягкий, дорогой оттенок для наведения мыши -->
    <SolidColorBrush x:Key="MetGlobal.Brushes.RowHover" Color="#F4F6F9" />


    <!-- ======================================================= -->
    <!-- 2. ГЛОБАЛЬНЫЕ НЕЯВНЫЕ СТИЛИ ПОЛЕЙ ВВОДА (IMPLICIT)      -->
    <!-- ======================================================= -->

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MahApps.Styles.TextBox}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5,8"/>
        <Setter Property="mah:TextBoxHelper.UseFloatingWatermark" Value="True"/>
        <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="{StaticResource MetGlobal.Brushes.PrimaryRed}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetGlobal.Brushes.Border}"/>
        <Setter Property="Foreground" Value="{StaticResource MetGlobal.Brushes.DarkText}"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5,8"/>
        <Setter Property="mah:TextBoxHelper.UseFloatingWatermark" Value="True"/>
        <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="{StaticResource MetGlobal.Brushes.PrimaryRed}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetGlobal.Brushes.Border}"/>
    </Style>

    <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource MahApps.Styles.DatePicker}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5,8"/>
        <Setter Property="mah:TextBoxHelper.UseFloatingWatermark" Value="True"/>
        <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="{StaticResource MetGlobal.Brushes.PrimaryRed}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetGlobal.Brushes.Border}"/>
    </Style>

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource MetGlobal.Brushes.DarkText}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>


    <!-- ======================================================= -->
    <!-- 3. СТИЛИ КНОПОК                                         -->
    <!-- ======================================================= -->

    <Style x:Key="MetGlobalPrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="Background" Value="{StaticResource MetGlobal.Brushes.PrimaryRed}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="4"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MetGlobal.Brushes.PrimaryRedHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource MetGlobal.Brushes.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource MetGlobal.Brushes.GrayText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MetGlobalOutlineButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource MetGlobal.Brushes.DarkText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetGlobal.Brushes.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="4"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MetGlobal.Brushes.BackgroundLight}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MetGlobalFlatButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MahApps.Styles.Button.Flat}">
        <Setter Property="Foreground" Value="{StaticResource MetGlobal.Brushes.PrimaryRed}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="4"/>
    </Style>


    <!-- ======================================================= -->
    <!-- 4. ИДЕАЛЬНЫЙ DATAGRID (ENTERPRISE UX FIX)               -->
    <!-- ======================================================= -->

    <!-- Шапка колонки -->
    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource MetGlobal.Brushes.BackgroundLight}"/>
        <Setter Property="Foreground" Value="{StaticResource MetGlobal.Brushes.GrayText}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="10,12"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetGlobal.Brushes.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <!-- ИСПРАВЛЕНИЕ: Переопределение ячейки (Запрещаем ячейке перекрывать фон строки) -->
    <Style x:Key="MetGlobalDataGridCell" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- Убираем уродливый пунктир при клике -->
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MetGlobal.Brushes.DarkText}"/>
            </Trigger>
            <!-- ГЛАВНЫЙ ФИКС: Заставляем ячейку быть прозрачной при наведении -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource MetGlobal.Brushes.DarkText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Переопределение строки -->
    <Style x:Key="MetGlobalDataGridRow" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MetGlobal.Brushes.RowHover}"/>
                <Setter Property="Foreground" Value="{StaticResource MetGlobal.Brushes.DarkText}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource MetGlobal.Brushes.RowSelected}"/>
                <Setter Property="Foreground" Value="{StaticResource MetGlobal.Brushes.DarkText}"/>
                <Setter Property="BorderBrush" Value="{StaticResource MetGlobal.Brushes.PrimaryRed}"/>
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                <!-- Сохраняем акцентную красную полоску -->
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Главный стиль таблицы -->
    <Style x:Key="EnterpriseDataGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MahApps.Styles.DataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource MetGlobal.Brushes.Border}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="Background" Value="{StaticResource MetGlobal.Brushes.BackgroundWhite}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MetGlobal.Brushes.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <!-- Подключаем наши исправленные стили ячеек и строк -->
        <Setter Property="CellStyle" Value="{StaticResource MetGlobalDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource MetGlobalDataGridRow}"/>
        <Setter Property="mah:DataGridHelper.AutoGeneratedCheckBoxColumnStyle" Value="{StaticResource MahApps.Styles.CheckBox.DataGrid}"/>
    </Style>

    <Style x:Key="EditableEnterpriseDataGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource EnterpriseDataGridStyle}">
        <Setter Property="IsReadOnly" Value="False"/>
    </Style>

</ResourceDictionary>