<mah:MetroWindow x:Class="MetGlobalCompany.WPF.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="MetGlobal ERP - Enterprise Edition" Height="850" Width="1400"
                 WindowStartupLocation="CenterScreen"
                 GlowBrush="{StaticResource MetGlobal.Brushes.PrimaryRed}"
                 BorderThickness="1"
                 SaveWindowPosition="True"
                 Background="{StaticResource MetGlobal.Brushes.BackgroundLight}">

    <mah:MetroWindow.Resources>
        <DataTemplate x:Key="MenuItemTemplate">
            <Grid>
                <Border x:Name="SeparatorBorder" Height="1" Background="#33334C" Margin="20,10" Visibility="Collapsed" Opacity="0.5"/>

                <Border x:Name="MenuBorder" Background="Transparent" CornerRadius="6" Margin="8,2" Cursor="Hand">
                    <Grid>
                        <Border x:Name="ActiveIndicator" Background="Transparent" Width="4" HorizontalAlignment="Left" CornerRadius="2" Margin="0,8,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="12,12">
                            <iconPacks:PackIconMaterial x:Name="MenuIcon" Kind="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MetGlobal.Brushes.SidebarText}" />
                            <TextBlock x:Name="MenuText" Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="{StaticResource MetGlobal.Brushes.SidebarText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter TargetName="SeparatorBorder" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="MenuBorder" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="MenuBorder" Property="Background" Value="{StaticResource MetGlobal.Brushes.SidebarSelected}"/>
                    <Setter TargetName="ActiveIndicator" Property="Background" Value="{StaticResource MetGlobal.Brushes.PrimaryRed}"/>
                    <Setter TargetName="MenuIcon" Property="Foreground" Value="White"/>
                    <Setter TargetName="MenuText" Property="Foreground" Value="White"/>
                </DataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="False"/>
                        <Condition Binding="{Binding IsSeparator}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="MenuBorder" Property="Background" Value="{StaticResource MetGlobal.Brushes.SidebarHover}"/>
                    <Setter TargetName="MenuIcon" Property="Foreground" Value="White"/>
                    <Setter TargetName="MenuText" Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <Grid>
        <mah:HamburgerMenu x:Name="HamburgerMenuControl"
                           DisplayMode="CompactInline"
                           IsPaneOpen="True"
                           HamburgerWidth="65"
                           OpenPaneLength="260"
                           PaneBackground="{StaticResource MetGlobal.Brushes.SidebarBackground}"
                           Foreground="White"
                           ItemsSource="{Binding MenuItems}"
                           SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                           ItemTemplate="{StaticResource MenuItemTemplate}"
                           OptionsItemsSource="{Binding OptionMenuItems}"
                           OptionsItemTemplate="{StaticResource MenuItemTemplate}">

            <mah:HamburgerMenu.HamburgerMenuHeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Height="90" Margin="15,0,0,0">
                        <Border Background="{StaticResource MetGlobal.Brushes.PrimaryRed}" Width="36" Height="36" CornerRadius="8" Margin="0,0,15,0">
                            <iconPacks:PackIconMaterial Kind="Earth" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="МЕТГЛОБАЛ" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="ENTERPRISE ERP" FontSize="11" Foreground="{StaticResource MetGlobal.Brushes.SidebarText}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </mah:HamburgerMenu.HamburgerMenuHeaderTemplate>

            <mah:HamburgerMenu.ContentTemplate>
                <DataTemplate>
                    <Grid Background="{StaticResource MetGlobal.Brushes.BackgroundLight}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Direction="270"/>
                            </Border.Effect>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding DataContext.CurrentViewModel.Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                                           FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="30,0,0,0" Foreground="{StaticResource MetGlobal.Brushes.DarkText}"/>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,30,0" VerticalAlignment="Center">
                                    <Button Command="{Binding DataContext.OpenHelpDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetGlobalOutlineButtonStyle}" BorderThickness="0" Margin="0,0,10,0" Padding="10,5" ToolTip="Руководство пользователя">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="HelpCircleOutline" Width="20" Height="20" Foreground="{StaticResource MetGlobal.Brushes.PrimaryRed}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Справка" VerticalAlignment="Center" Foreground="{StaticResource MetGlobal.Brushes.DarkText}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding DataContext.OpenImportDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MetGlobalOutlineButtonStyle}" BorderThickness="0" Margin="0,0,15,0" Padding="10,5" ToolTip="Импорт данных из Excel">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="FileExcelBox" Width="20" Height="20" Foreground="{StaticResource MetGlobal.Brushes.SuccessGreen}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Импорт" VerticalAlignment="Center" Foreground="{StaticResource MetGlobal.Brushes.DarkText}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Width="350" Height="40" Background="{StaticResource MetGlobal.Brushes.BackgroundLight}" CornerRadius="20" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center" Foreground="{StaticResource MetGlobal.Brushes.GrayText}" Margin="15,0,10,0"/>
                                            <TextBox mah:TextBoxHelper.Watermark="Глобальный поиск (Ctrl+F)" mah:TextBoxHelper.ClearTextButton="True"
                                                     Text="{Binding DataContext.GlobalSearchText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                     Width="280" VerticalAlignment="Center" FontSize="14" Background="Transparent" BorderThickness="0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ContentControl Grid.Row="1" Content="{Binding DataContext.CurrentViewModel, RelativeSource={RelativeSource AncestorType=Window}}" Margin="25"/>
                    </Grid>
                </DataTemplate>
            </mah:HamburgerMenu.ContentTemplate>
        </mah:HamburgerMenu>
    </Grid>
</mah:MetroWindow>