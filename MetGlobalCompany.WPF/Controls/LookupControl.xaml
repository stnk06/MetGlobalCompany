<UserControl x:Class="MetGlobalCompany.WPF.Controls.LookupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Name="Root">
    <Border BorderBrush="{StaticResource MetGlobal.Brushes.Border}" BorderThickness="1" Background="White" CornerRadius="2" Height="34">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding ElementName=Root, Path=Text}" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource MetGlobal.Brushes.DarkText}" TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Column="0" Text="{Binding ElementName=Root, Path=Watermark}" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource MetGlobal.Brushes.GrayText}" FontStyle="Italic">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=Root, Path=Text}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=Root, Path=Text}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Grid.Column="1" Command="{Binding ElementName=Root, Path=ClearCommand}" CommandParameter="{Binding ElementName=Root, Path=CommandParameter}" Background="Transparent" BorderThickness="0" Width="30" Cursor="Hand" ToolTip="Очистить">
                <iconPacks:PackIconMaterial Kind="Close" Width="10" Height="10" Foreground="{StaticResource MetGlobal.Brushes.GrayText}"/>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=Root, Path=Text}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=Root, Path=Text}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2" Command="{Binding ElementName=Root, Path=SelectCommand}" CommandParameter="{Binding ElementName=Root, Path=CommandParameter}" Background="{StaticResource MetGlobal.Brushes.BackgroundLight}" BorderBrush="{StaticResource MetGlobal.Brushes.Border}" BorderThickness="1,0,0,0" Width="34" Cursor="Hand" ToolTip="Выбрать из справочника">
                <iconPacks:PackIconMaterial Kind="Magnify" Width="14" Height="14" Foreground="{StaticResource MetGlobal.Brushes.DarkText}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>